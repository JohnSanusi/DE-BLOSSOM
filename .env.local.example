# ──────────────────────────────────────────────────────────
# DE-BLOSSOM COOPERATIVE — SUPABASE ENVIRONMENT CONFIGURATION
# ──────────────────────────────────────────────────────────

# Your project URL (Find in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your project Anon Public Key (Find in Supabase Dashboard -> Project Settings -> API)
# Safe to expose in the browser; protected strictly by PostgreSQL Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret Service Role Key (Find in Supabase Dashboard -> Project Settings -> API)
# ⚠️ CRITICAL: NEVER EXPOSE TO CLIENT. Only used on the server for admin role provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
